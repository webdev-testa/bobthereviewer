{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bobthereviewer repository map",
  "description": "A whole-repository, file-level picture: which files import which, and when each file last changed. Generated by code from the source tree and git history, never by a model.",
  "type": "object",
  "required": ["schema_version", "repo", "sha", "generated_at", "modules", "edges", "unknowns", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "repo": {
      "type": "string",
      "description": "Repository identity, as recorded for the review"
    },
    "sha": {
      "type": "string",
      "description": "Revision the map describes"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "modules": {
      "type": "array",
      "description": "Every first-party source file, with the language, support tier and last commit that touched it",
      "items": { "$ref": "#/definitions/map_module" }
    },
    "edges": {
      "type": "array",
      "description": "File-to-file import edges, at most one per pair, carrying the earliest line",
      "items": { "$ref": "#/definitions/map_edge" }
    },
    "unknowns": {
      "type": "array",
      "description": "Imports that could not be resolved. An unknown is not an absence of impact and must never be read as safe",
      "items": { "$ref": "#/definitions/map_unknown" }
    },
    "limits": {
      "type": "array",
      "description": "Plain statements about what this map does not show",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "map_module": {
      "type": "object",
      "required": ["path", "language", "tier", "last_commit"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative path — never an absolute filesystem path"
        },
        "language": { "type": "string" },
        "tier": {
          "type": "string",
          "enum": ["full", "static", "static_same_file", "experimental"],
          "description": "Only 'full' means static impact plus tests and probes were run"
        },
        "last_commit": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["sha", "date", "subject"],
              "additionalProperties": false,
              "properties": {
                "sha": { "type": "string" },
                "date": { "type": "string" },
                "subject": { "type": "string" },
                "pr": { "type": ["integer", "null"] }
              }
            }
          ]
        }
      }
    },
    "map_edge": {
      "type": "object",
      "required": ["from", "to", "kind", "line"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "description": "Importing file, repository-relative" },
        "to": { "type": "string", "description": "Imported file, repository-relative" },
        "kind": { "type": "string", "const": "import" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "map_unknown": {
      "type": "object",
      "required": ["path", "line", "expression", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "expression": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
